rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Imagens de cada loja ficam em /stores/{storeId}/...
    // Leitura é pública (o catálogo precisa exibir fotos e banner sem login).
    // Escrita só é permitida para o dono autenticado daquela loja.
    match /stores/{storeId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.storeId == storeId;
    }
  }
}
